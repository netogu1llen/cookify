# ============================================================================
# Cookify · configuracion del servicio de precios
#
# Copiar como .env y reemplazar los valores. El archivo .env NO se versiona:
# esta en .gitignore. Este archivo si, y solo trae valores de ejemplo.
#
#   cp .env.example .env
#
# Ningun valor real de este archivo sirve para entrar a nada: la clave de la
# API es de ejemplo y la base solo escucha en localhost.
# ============================================================================

# --- base de datos ----------------------------------------------------------
# Los tres primeros los usa el contenedor de PostgreSQL para crearse.
POSTGRES_DB=cookify
POSTGRES_USER=cookify
POSTGRES_PASSWORD=cambiame_en_tu_env

# Puerto del equipo por el que se llega a la base. No es 5432 porque es muy
# comun tener ya un PostgreSQL ocupandolo.
POSTGRES_PORT=5434

# --- servicio ---------------------------------------------------------------
# Los que lee el servicio al arrancar. El host es el del equipo cuando se corre
# con Gradle, y es "db" cuando el servicio corre dentro de docker-compose.
COOKIFY_DB_URL=jdbc:postgresql://localhost:5434/cookify
COOKIFY_DB_USUARIO=cookify
COOKIFY_DB_CLAVE=cambiame_en_tu_env

# No es 8080: ese puerto lo suele tener ocupado un Apache local.
COOKIFY_PUERTO=8090

# Clave que exigen POST, PUT y DELETE. La lectura es abierta.
# Generar una propia:  openssl rand -hex 24
COOKIFY_API_KEY=clave_de_ejemplo_cambiala

# --- recolector -------------------------------------------------------------
# Paginas por categoria que recorre como maximo. Cuatro cubren las categorias
# mas grandes del arbol de comida de las dos cadenas.
COOKIFY_RECOLECTOR_PAGINAS=4

# Pausa entre peticiones al sitio de la cadena. No es un detalle de rendimiento
# sino de cortesia: Santa Isabel empieza a responder 502 sin ella.
COOKIFY_RECOLECTOR_PAUSA_MS=400
